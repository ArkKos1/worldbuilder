
/* =====================================
   Worldbuilder — Dark Blue-Graphite Theme
   ===================================== */

/* Main application window */
QMainWindow {
    background-color: #161F2A;
    color: #E0E8F0;
}

/* General text */
QWidget {
    color: #E0E8F0;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* Menu bar */
QMenuBar {
    background-color: #1E2A37;
    color: #E0E8F0;
    border: none;
    padding: 3px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background-color: #35475A;
}

QMenuBar::item:pressed {
    background-color: #1769C2;
}

/* Dropdown menus */
QMenu {
    background-color: #1E2A37;
    color: #E0E8F0;
    border: 1px solid #35475A;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #26384B;
}

QMenu::separator {
    height: 1px;
    background-color: #35475A;
    margin: 4px 8px;
}

/* Toolbars */
QToolBar {
    background-color: #1B2837;
    border: none;
    spacing: 6px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: #E0E8F0;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #26384B;
    border-color: #35475A;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #1769C2;
}

/* Dock panels */
QDockWidget {
    color: #E0E8F0;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #1E2A37;
    padding: 8px;
    border-bottom: 1px solid #35475A;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #26384B;
}

/* Input fields */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #1B2837;
    color: #E0E8F0;
    border: 1px solid #35475A;
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #1769C2;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #1769C2;
}

/* Buttons */
QPushButton {
    background-color: #26384B;
    color: #E0E8F0;
    border: 1px solid #35475A;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #35475A;
}

QPushButton:pressed {
    background-color: #1769C2;
}

/* Lists and trees */
QListWidget,
QTreeWidget,
QTreeView,
QListView {
    background-color: #1B2837;
    alternate-background-color: #1E2A37;
    color: #E0E8F0;
    border: 1px solid #35475A;
    outline: none;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #1769C2;
    color: #FFFFFF;
}

/* Tabs */
QTabWidget::pane {
    background-color: #1B2837;
    border: 1px solid #35475A;
}

QTabBar::tab {
    background-color: #1E2A37;
    color: #9EAFBF;
    padding: 7px 12px;
    border: 1px solid #35475A;
}

QTabBar::tab:selected {
    background-color: #26384B;
    color: #E0E8F0;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #161F2A;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #35475A;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background-color: #161F2A;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #35475A;
    min-width: 24px;
    border-radius: 4px;
}

/* Tooltips */
QToolTip {
    background-color: #1E2A37;
    color: #E0E8F0;
    border: 1px solid #35475A;
    padding: 5px;
}
